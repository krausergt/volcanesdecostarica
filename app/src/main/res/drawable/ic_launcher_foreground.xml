<?xml version="1.0" encoding="utf-8"?>
<!--
  Frente del ícono adaptativo: dos picos de montaña superpuestos,
  fiel al diseño PNG original del icono de la app.

  Viewport 108×108dp.  Los ápices a y=24 e y=28 quedan dentro
  de la zona segura r=33 centrada en (54,54).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pico izquierdo (secundario, detrás): ápice en (44, 28). -->
    <path
        android:fillColor="#F05A28"
        android:pathData="M18,82 L44,28 L68,82 Z" />

    <!-- Pico derecho (principal, enfrente): más alto, cubre el flanco derecho del izquierdo. -->
    <path
        android:fillColor="#F05A28"
        android:pathData="M38,82 L64,24 L90,82 Z" />

    <!--
      Triángulo de sombra en el valle entre los dos ápices.
      Llena el hueco blanco con un tono más oscuro para dar profundidad
      (mismo efecto visual del notch oscuro del ícono PNG original).
    -->
    <path
        android:fillColor="#C0390F"
        android:pathData="M44,28 L64,24 L52,48 Z" />
</vector>
