<?xml version="1.0" encoding="utf-8"?>
<!--
  Frente del ícono adaptativo, viewport 108×108dp.
  Silueta del ícono original: cadena de dos picos con base plana,
  más un slash diagonal blanco (material-design highlight) que replica
  el efecto de luz del web_hi_res_512.png.

  La paleta usa LavaRed (#BF360C) de la app en lugar del naranja original.
  El slash blanco solo es visible sobre la silueta LavaRed; sobre el fondo
  blanco del background layer resulta invisible — no requiere clip-path.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Silueta de la cadena montañosa: ruta única conectada.
        (20,76)  base izquierda
        (36,32)  ápice pico izquierdo (secundario)
        (50,48)  valle entre picos
        (62,20)  ápice pico derecho (principal, más alto)
        (88,76)  base derecha
    -->
    <path
        android:fillColor="#BF360C"
        android:pathData="M20,76 L36,32 L50,48 L62,20 L88,76 Z" />

    <!--
      Slash diagonal blanco: reproduce el efecto de "rayo de luz" del
      ícono original. Al quedar sobre el fondo blanco es invisible;
      solo se percibe donde corta la silueta LavaRed.
        (46,40) → (60,28)  borde superior del slash
        (88,76) → (74,76)  borde inferior (a lo largo de la base)
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,40 L60,28 L88,76 L74,76 Z" />
</vector>
