<?xml version="1.0" encoding="utf-8"?>
<!--
  Vector base para el splash screen animado.
  Misma silueta de dos picos del ícono original, en blanco
  para contrastar sobre el círculo naranja del splash.
  Estado inicial: escala 0 (crece con la animación).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Pivot en la base central del conjunto de picos para que
      el crecimiento sea de abajo hacia arriba.
    -->
    <group
        android:name="volcano_group"
        android:pivotX="54"
        android:pivotY="82"
        android:scaleX="0"
        android:scaleY="0">

        <!-- Pico izquierdo (detrás). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M18,82 L44,28 L68,82 Z" />

        <!-- Pico derecho (delante). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M38,82 L64,24 L90,82 Z" />

        <!-- Sombra de valle: tono gris-blanco levemente más oscuro para mantener la profundidad. -->
        <path
            android:fillColor="#E0E0E0"
            android:pathData="M44,28 L64,24 L52,48 Z" />
    </group>
</vector>
