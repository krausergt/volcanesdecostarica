<?xml version="1.0" encoding="utf-8"?>
<!--
  Vector base para el splash screen animado.
  Misma silueta de dos picos en blanco (contraste sobre el círculo LavaRed).
  Estado inicial: escala 0.2 + desplazada 30dp hacia abajo;
  la animación la hace crecer y subir simultáneamente.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="volcano_group"
        android:pivotX="54"
        android:pivotY="76"
        android:scaleX="0.2"
        android:scaleY="0.2"
        android:translateY="30">

        <!-- Silueta blanca de la cadena montañosa (misma geometría que el launcher). -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M20,76 L36,32 L50,48 L62,20 L88,76 Z" />

        <!-- Slash en blanco roto (#F0E8E6) para insinuar profundidad sobre blanco. -->
        <path
            android:fillColor="#F0E8E6"
            android:pathData="M46,40 L60,28 L88,76 L74,76 Z" />
    </group>
</vector>
