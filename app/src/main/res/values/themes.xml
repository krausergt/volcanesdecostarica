<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Tema de la ventana durante el arranque (SplashScreen).
      postSplashScreenTheme restaura el tema real de la app en cuanto Compose
      toma el control; MainActivity llama installSplashScreen() antes de super.onCreate().
    -->
    <style name="Theme.VolcanesCostaRica" parent="Theme.SplashScreen">
        <!-- Fondo de toda la pantalla: obsidiana oscura, contraste dramático. -->
        <item name="windowSplashScreenBackground">#1A110F</item>
        <!-- Ícono animado: volcán que crece + llama ámbar encendiéndose. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <!-- Círculo detrás del ícono: rojo lava, coherente con la paleta. -->
        <item name="windowSplashScreenIconBackgroundColor">#BF360C</item>
        <!-- Tema real que hereda la UI Compose una vez que termina el splash. -->
        <item name="postSplashScreenTheme">@style/Theme.App</item>
    </style>

    <!-- Tema base de la ventana Compose: sin ActionBar, sin color propio (Compose lo gestiona). -->
    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
